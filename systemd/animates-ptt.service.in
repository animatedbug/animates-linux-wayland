[Unit]
Description=Animates push-to-talk (hold key = voice, tap = text chat)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
EnvironmentFile=-%h/.config/animates-linux.conf
ExecStart=@VENV@/bin/python -u @REPO@/ptt/ptt.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
